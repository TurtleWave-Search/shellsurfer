{
    "id": "resizable_toolbar",
    "title": "Resizable Everything",
    "description": "Make all elements resizable",
    "version": "1.3.0",
    "tag": null,
    "enabled": true,
    "runtime": "page",
    "mode": "function",
    "code": "ipcRenderer.send('exec-in-page', 'document.querySelectorAll(\"*\").forEach(el=>{el.style.resize=\"both\";el.style.overflow=\"auto\";});')"
},
{
    "id": "global_dark_mode",
    "title": "Global Dark Mode",
    "description": "Forces dark mode on pages",
    "version": "1.4.0",
    "tag": "Store: Verified",
    "enabled": true,
    "runtime": "page",
    "mode": "function",
    "code": "ipcRenderer.send('exec-in-page', 'document.documentElement.style.filter=\"invert(1) hue-rotate(180deg)\";document.querySelectorAll(\"img,video\").forEach(el=>{el.style.filter=\"invert(1) hue-rotate(180deg)\"});');"
